    "          [200, -0.1, 150, 180, 400, 110, 110, 1e4*np.ones(7), 1])\n",
    "\n",
    "mc_model = opt.mcmc(fit_keys, logscaled_params, array_params, target_image, err_map, bounds, nwalkers=100, niter=100, burns=20)"
